{
  "spec": {
    "enable_host_anti_affinity": true,
    "runtime": {
      "autoscaling": {
        "min": 1,
        "max": 1
      }
    },
    "release": {
      "strategy": {
        "type": "RollingUpdate"
      }
    },
    "cloud_permissions": {
      "aws": {
        "enable_irsa": false
      }
    }
  },
  "disabled": false
}